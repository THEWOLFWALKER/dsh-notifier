{
  "name": "dsh-notifier",
  "version": "0.3.0",
  "description": "DSH 统一通知推送插件：一个 notify() API 打天下 + 多渠道 adapter；远程审批/远程会话支持 telegram/feishu/qq/wxpusher/wechat 五通道双向回传。零运行时依赖（只用 fetch + node:crypto + 原生 WebSocket）。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "test",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" \"test/*.spec.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.46.0",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/THEWOLFWALKER/dsh-notifier.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "notify",
    "notification",
    "dingtalk",
    "feishu",
    "wxpusher",
    "pushplus",
    "serverchan",
    "bark",
    "telegram",
    "webhook",
    "qq-bot",
    "weixin",
    "ilink",
    "remote-approval"
  ]
}
