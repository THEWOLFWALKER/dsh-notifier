{
  "name": "dsh-notifier",
  "version": "0.10.2",
  "description": "DSH 通知插件：一个 notify() 打通 28 个出站渠道；支持 Telegram / 飞书 / QQ / 钉钉等入站远程审批、提问与对话回传；内置本机 Web 管理台。零运行时依赖。",
  "type": "module",
  "main": "src/plugin-entry.mjs",
  "exports": {
    ".": "./src/plugin-entry.mjs",
    "./internal": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "test",
    "scripts/channel-login.mjs",
    "scripts/channel-selfcheck.mjs",
    "scripts/gen-channel-matrix.mjs",
    "scripts/route.mjs",
    "scripts/verify-release.mjs",
    "scripts/wechat-login.mjs",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "PLUGINS.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/guide.md",
    "docs/upgrade-guide.md",
    "docs/upgrade-guide.en.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" \"test/*.spec.mjs\"",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dshQuality": {
    "testCount": 1625
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "qrcode-terminal": "0.12.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/THEWOLFWALKER/dsh-notifier.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "notify",
    "notification",
    "dingtalk",
    "feishu",
    "wxpusher",
    "pushplus",
    "serverchan",
    "bark",
    "telegram",
    "webhook",
    "qq-bot",
    "weixin",
    "ilink",
    "qr-login",
    "remote-approval"
  ],
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "immediate",
      "dispose": "supported"
    },
    "permissions": [
      "harness:tool",
      "harness:event",
      "network:outbound",
      "network:listen",
      "file:read",
      "file:write",
      "subprocess:exec",
      "shell:none",
      "credentials:write"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.0-rc.6"
      ]
    },
    "capability": {
      "id": "notify",
      "kind": "tool",
      "invocation": "invoke the model-facing notify tool with a message and an optional target channel through the DSH ToolRuntime",
      "expected": "the message is delivered to the configured channel (e.g. Telegram) and a structured result is returned; an unreachable or unconfigured channel returns a structured skipped/failed result without blocking the turn"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  }
}
