{
  "name": "dsh-notifier",
  "version": "0.3.3",
  "description": "DSH 统一通知推送插件：一个 notify() API 打天下 + 多渠道 adapter；远程审批/远程会话支持 telegram/feishu/qq/wxpusher/wechat/dingtalk 六通道双向回传；QQ/钉钉/飞书官方扫码授权；本机 Web 管理台（凭证/路由/扫码授权网页可管）。零运行时依赖（只用 fetch + node:crypto + 原生 WebSocket）。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "test",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" \"test/*.spec.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.61.1",
    "@tencent-connect/qqbot-connector": "^1.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/THEWOLFWALKER/dsh-notifier.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "notify",
    "notification",
    "dingtalk",
    "feishu",
    "wxpusher",
    "pushplus",
    "serverchan",
    "bark",
    "telegram",
    "webhook",
    "qq-bot",
    "weixin",
    "ilink",
    "dingtalk",
    "qr-login",
    "remote-approval"
  ],
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "harness:tool",
      "harness:event",
      "network:outbound",
      "network:listen",
      "files:write"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.0-rc.6"
      ]
    },
    "capability": {
      "id": "notify",
      "kind": "tool",
      "invocation": "invoke the model-facing notify tool with a message and an optional target channel through the DSH ToolRuntime",
      "expected": "the message is delivered to the configured channel (e.g. Telegram) and a structured result is returned; an unreachable or unconfigured channel returns a structured skipped/failed result without blocking the turn"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  }
}
